{
  "execution_mode": "semi_automatic",
  "trigger_mode": "user_conversation",
  "scheduler_enabled": false,
  "remote_side_effects_default": false,
  "playwright_cli_version": "0.1.20",
  "program": {
    "mode": "manual_tdk_only",
    "entrypoint": "workbench.py",
    "url": "http://127.0.0.1:8766",
    "background_monitor": false
  },
  "tdk": {
    "owner": "Pony",
    "keyword_and_group_reference": "https://docs.google.com/spreadsheets/d/1-3DvtAhJQu83G9fA1TWrEZIKiosOzvwDWYknEFXKGJ0/edit?gid=0",
    "group_rule": "recheck current Pony assignment for each launch; no fixed group or default all",
    "competitor_rule": "AI checks relevant sites at each launch and writes original copy",
    "history": "data/tdk-fingerprints.json",
    "review_rule": "Leo only when specifically requested for that batch",
    "write_target": "Bing launch sheet E:H for confirmed Pony rows",
    "downstream": "user_managed"
  },
  "business_browser_policy": {
    "mode": "normal_persistent",
    "incognito_allowed": false,
    "guest_allowed": false,
    "retain_login": true,
    "profile_path": "private/launch-browser",
    "scope": "authenticated Google Sheets access"
  },
  "rs_assistant": {
    "enabled": false,
    "status": "reserved_not_implemented",
    "reference_workspace": "C:/RS",
    "activation_requires": "User explicitly requests integration after robot optimization"
  }
}
