{
  "schema_version": "2.0",
  "artifact_type": "declarative_requirements_not_an_executable_validator",
  "description": "Codex需实现检查器和失败用例。存在本文件不代表规则已执行，handler_implemented初始均为false。严重度按真实适用条件、baseline与新回归分类执行。",
  "status_values": [
    "pass",
    "fail",
    "blocked",
    "needs_review",
    "not_applicable"
  ],
  "default_policy": {
    "pass_requires_evidence": true,
    "not_applicable_requires_reason": true,
    "missing_dependency_is_not_pass": true,
    "fixture_pass_is_not_real_app_pass": true,
    "new_p0_p1_prevent_delivery": true,
    "human_acceptance_is_separate": true,
    "unknown_production_state_stays_unknown": true
  },
